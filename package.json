{
  "name": "newtonova",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "fetch": "node --env-file-if-exists=.env scripts/fetch-orgs.mjs && node --env-file-if-exists=.env scripts/fetch-events.mjs",
    "predev": "npm run fetch",
    "dev": "astro dev",
    "prebuild": "npm run fetch",
    "build": "astro build",
    "preview": "astro preview",
    "db:migrate:local": "wrangler d1 migrations apply newtonova --config db/wrangler.jsonc --local",
    "db:migrate": "wrangler d1 migrations apply newtonova --config db/wrangler.jsonc --remote",
    "import:local": "node --env-file-if-exists=.env scripts/import-from-notion.mjs",
    "import": "node --env-file-if-exists=.env scripts/import-from-notion.mjs --remote"
  },
  "dependencies": {
    "@notionhq/client": "^5.27.1",
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "wrangler": "^4.161.0"
  }
}
