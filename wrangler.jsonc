// Cloudflare settings for the newtonova Worker (the live site).
// Astro's Cloudflare adapter fills in the entrypoint and static assets.
// Secrets are never written here: use `npx wrangler secret put <NAME>`.
{
  "name": "newtonova",
  "compatibility_date": "2026-10-01",
  // Cloudflare Access app that guards /admin (checked in src/admin/access.ts).
  // Not secret. Empty means /admin refuses everyone.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "still-unit-07fd.cloudflareaccess.com",
    "ACCESS_AUD": "59c4f4ecc9beaa8390210d8ab5779e21c342923e865431313720442d0f1187db"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newtonova",
      "database_id": "9708a4bf-d7ae-4321-9c29-8c7619e1c7e2",
      "migrations_dir": "db/migrations"
    }
  ]
}
