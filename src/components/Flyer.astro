---
// A group's flyer, as on the Groups board. Also shown to organizers on /yours.
// On Groups it's an <li> with filter data; the browser script there keeps the
// Next tab current (data-next*).
import { copy } from "../copy";
import { placeColor } from "../routes";
import { tilts, pins, type FlyerOrg, type NextEvent } from "../flyer";
import { confirmedMonth } from "../verified";
import "../styles/flyer.css";

interface Props {
  org: FlyerOrg;
  index: number;
  next: NextEvent[];
  /** "Your group? Verify it" tab ("Update it" once verified). Left out on the organizer pages. */
  claimHref?: string;
  /** Heading level for the group's name: h3 on the board, h2 on its own. */
  headingLevel?: 2 | 3;
  /** li on the board (inside a ul), div on its own. */
  as?: "li" | "div";
  nextLabel?: string;
}

const { org: o, index: i, next, claimHref, headingLevel = 3, as = "li", nextLabel = copy.listing.nextLabel } = Astro.props;
const Tag = as;
const H = `h${headingLevel}` as "h2" | "h3";
const confirmed = confirmedMonth(o.verifiedAt);
const claimTab = o.verified ? copy.listing.claimTabVerified : copy.listing.claimTab;
---

<Tag
  class="flyer"
  id={`org-${o.id}`}
  data-categories={o.category.join("|")}
  data-areas={o.area.join("|")}
  data-search={[o.name, o.blurb, ...o.category, ...o.area].join(" ").toLowerCase()}
  data-next={JSON.stringify(next)}
  style={`--paper:${placeColor(o.area)}; --tilt:${tilts[i % tilts.length]}deg; --pin:${pins[i % pins.length]}`}
>
  <span class="pin" aria-hidden="true"></span>
  <H>
    {o.website
      ? <a href={o.website} target="_blank" rel="noopener">{o.name}<span class="visually-hidden"> {copy.listing.newTab}</span></a>
      : o.name}
  </H>
  <p class="meta">
    {o.area.length > 0 && (
      <span class="place">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z"></path>
          <circle cx="12" cy="9" r="2.5"></circle>
        </svg>
        {o.area.join(", ")}
      </span>
    )}
    <span class="kinds">{o.category.join(" + ")}</span>
  </p>
  <p class="blurb">{o.blurb}</p>
  {confirmed && (
    <p class="confirmed">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.7 2.7L16 9.8"></path></svg>
      {copy.listing.confirmed(confirmed)}
    </p>
  )}
  <div class="tabs">
    <a
      class="tab tab-next"
      href={next[0]?.link ?? o.website}
      target="_blank"
      rel="noopener"
      hidden={!next[0]}
      data-next-tab
    >
      <span class="tab-k">{nextLabel}</span>
      <span data-next-when>{next[0]?.when}</span>
      <span class="visually-hidden" data-next-name>: {next[0]?.name}, {o.name} {copy.listing.newTab}</span>
    </a>
    <span class="tab tab-quiet" hidden={!!next[0]} data-next-none>
      <span class="tab-k">{nextLabel}</span>
      <span>{copy.listing.nextNone}</span>
    </span>
    {o.website && (
      <a class="tab" href={o.website} target="_blank" rel="noopener">
        <span class="tab-k">{copy.listing.visitTab[0]}</span>
        <span>{copy.listing.visitTab[1]}<span class="visually-hidden">: {o.name} {copy.listing.newTab}</span></span>
      </a>
    )}
    {claimHref && (
      <a class="tab" href={claimHref}>
        <span class="tab-k">{claimTab[0]}</span>
        <span>{claimTab[1]}<span class="visually-hidden">: {o.name}</span></span>
      </a>
    )}
  </div>
</Tag>
