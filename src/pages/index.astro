---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { copy, TALLY_URL } from "../copy";
import { categories } from "../categories";
import { wideAreas } from "../areas";
import { routes, placeColor, anywhereColor } from "../routes";
import { whenShort, isUpcoming } from "../event-dates";
import photo from "../assets/becca.jpg";
import orgsData from "../data/orgs.json";
import eventsData from "../data/events.json";
import "../styles/home.css";

type Org = {
  id: string;
  name: string;
  website: string;
  category: string[];
  area: string[];
  blurb: string;
  status: string;
  verified: boolean;
};

type Ev = { id: string; name: string; start: string; end: string | null; allDay: boolean; link: string; orgId: string | null; area: string[] };

// Prefills the form's hidden org and org_id fields; URLSearchParams handles encoding.
const claimHref = (o: Org) => `${TALLY_URL}?${new URLSearchParams({ org: o.name, org_id: o.id })}`;

const orgs = (orgsData as Org[])
  .filter((o) => o.status === "Live")
  .sort((a, b) => a.name.localeCompare(b.name));
const orgById = new Map(orgs.map((o) => [o.id, o]));

// Upcoming events from Live groups. The browser drops any that pass before the next rebuild.
const upcoming = (eventsData as Ev[])
  .filter((e) => isUpcoming(e) && e.orgId && orgById.has(e.orgId))
  .sort((a, b) => a.start.localeCompare(b.start));

// Coming up: a few spares, so the sheet stays full as the first ones pass.
const coming = upcoming.slice(0, 10).map((e) => {
  const org = orgById.get(e.orgId!)!;
  // Colour by where the event happens (as on Events); fall back to the group's towns.
  return { ...e, when: whenShort(e), org: org.name, color: placeColor(e.area.length ? e.area : org.area) };
});
const COMING_SHOWN = 4;

// Each flyer's next few events; the first one still to come fills the "Next" tab.
const nextFor = (o: Org) =>
  upcoming
    .filter((e) => e.orgId === o.id)
    .slice(0, 3)
    .map((e) => ({ name: e.name, start: e.start, end: e.end, allDay: e.allDay, link: e.link, when: whenShort(e) }));

// Only show filters for categories that have at least one listing.
const usedCategories = categories.filter((c) => orgs.some((o) => o.category.includes(c.name)));

// Statewide and National groups also count under every town.
const inTown = (o: Org, t: string) => o.area.includes(t) || o.area.some((a) => wideAreas.includes(a));
const routeData = routes.map((r) => ({
  ...r,
  count: orgs.filter((o) => r.towns.some((t) => inTown(o, t))).length,
  towns: r.towns.map((t) => ({ name: t, count: orgs.filter((o) => inTown(o, t)).length })).filter((t) => t.count > 0),
}));

// Warn at build time if a group lists a town no route group covers, so it can be added to src/routes.ts.
const routed = new Set([...routes.flatMap((r) => r.towns), ...wideAreas]);
const unrouted = [...new Set(orgs.flatMap((o) => o.area).filter((a) => !routed.has(a)))];
if (unrouted.length) console.warn(`[routes] Towns not in any route group: ${unrouted.join(", ")}`);

// Slight, repeatable tilts and pin colours so the board looks hand-pinned.
const tilts = [-1.4, 0.8, -0.4, 1.3, -0.9, 0.3, 1.0, -1.1];
const pins = ["#E2402F", "#1F6FD1", "#1E9E57", "#F2B705", "#7A4FD6"];
---

<Base current="groups">
  <section class="wrap home-hero">
    <div class="home-intro">
      <h1>{copy.hero.headline} <span class="hl">{copy.hero.headlineHighlight}</span>.</h1>
      <figure class="home-note">
        <Image src={photo} alt={copy.note.photoAlt} width={168} height={168} class="home-note-photo" />
        <figcaption><strong>{copy.note.hello}</strong> {copy.note.body}</figcaption>
      </figure>
      <label class="search-label" for="search">{copy.hero.searchLabel}</label>
      <div class="search-field">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <input id="search" type="search" autocomplete="off" placeholder={copy.hero.searchPlaceholder} />
      </div>
    </div>

    {coming.length > 0 && (
      <aside class="coming" aria-labelledby="coming-title">
        <span class="tape" aria-hidden="true"></span>
        <h2 id="coming-title">{copy.coming.heading}</h2>
        <ul>
          {coming.map((e, i) => (
            <li
              style={`--where:${e.color}`}
              data-start={e.start}
              data-end={e.end ?? ""}
              data-all-day={String(e.allDay)}
              hidden={i >= COMING_SHOWN}
            >
              <a href={e.link} target="_blank" rel="noopener">
                <span class="when">{e.when}</span>
                <span class="what">{e.name}</span>
                <span class="who">{e.org}</span>
                <span class="visually-hidden"> {copy.listing.newTab}</span>
              </a>
            </li>
          ))}
        </ul>
        <a class="more" href="/events/">{copy.coming.more}</a>
      </aside>
    )}
  </section>

  <section class="wrap routes" aria-labelledby="routes-title">
    <div class="routes-head">
      <h2 id="routes-title">{copy.routes.heading}</h2>
      <button type="button" class="paper-btn" data-route-clear>{copy.routes.all}</button>
    </div>
    <div class="route-cards">
      {routeData.map((r, i) => (
        <div class="route-card" style={`--where:${r.color}`}>
          <div class="route-top">
            <button
              type="button"
              class="route-name"
              data-route={r.id}
              data-towns={r.towns.map((t) => t.name).join("|")}
              aria-pressed="false"
            >
              {r.shield === "interstate" ? (
                <svg class="shield" viewBox="0 0 60 60" aria-hidden="true">
                  <path d="M6 6 Q30 0 54 6 L54 30 Q54 50 30 58 Q6 50 6 30 Z" fill="#fff" />
                  <path d="M10 10 Q30 5 50 10 L50 20 L10 20 Z" fill="#B31B2C" />
                  <path d="M10 22 L50 22 L50 30 Q50 47 30 54 Q10 47 10 30 Z" fill="#0B3D91" />
                  <text x="30" y={r.number.length > 2 ? 42 : 43} text-anchor="middle" font-size={r.number.length > 2 ? 17 : 21} font-weight="800" fill="#fff">{r.number}</text>
                </svg>
              ) : (
                // Virginia primary route marker: white shield cut out of a black rectangle.
                <svg class="shield shield-va" viewBox="0 0 60 48" aria-hidden="true">
                  <rect width="60" height="48" rx="2" fill="#111" />
                  <path d="M6 3 H54 Q57 3 57 6 V17 Q57 36 30 45.5 Q3 36 3 17 V6 Q3 3 6 3 Z" fill="#fff" />
                  <text x="30" y="31.5" text-anchor="middle" font-size="25" font-weight="800" letter-spacing="-1" fill="#111">{r.number}</text>
                </svg>
              )}
              <span class="route-label">{r.label}</span>
              <span class="route-n">{r.count}<span class="visually-hidden"> groups</span></span>
            </button>
            <button
              type="button"
              class="towns-toggle"
              aria-expanded="false"
              aria-controls={`towns-${r.id}`}
              aria-label={`${copy.routes.showTowns}: ${r.label}`}
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
            </button>
          </div>
          <ul class="towns" id={`towns-${r.id}`}>
            {r.towns.map((t) => (
              <li>
                <button type="button" class="town" data-town={t.name} aria-pressed="false">
                  {t.name} <span>{t.count}<span class="visually-hidden"> groups</span></span>
                </button>
              </li>
            ))}
          </ul>
          <p class="route-panel" aria-hidden="true">{copy.listing.total(r.count)}</p>
        </div>
      ))}
    </div>
    <p class="routes-note">
      <span class="swatch" style={`--where:${anywhereColor}`} aria-hidden="true"></span>{copy.routes.anywhere}{" "}
      {copy.routes.note}
    </p>
  </section>

  <section class="wrap board-section" aria-labelledby="groups-title">
    <h2 id="groups-title" class="visually-hidden">{copy.nav.groups}</h2>
    <fieldset class="kind-tags">
      <legend class="visually-hidden">{copy.filters.label}</legend>
      <button class="kind-tag" type="button" data-category="" aria-pressed="true">{copy.filters.all}</button>
      {usedCategories.map((c) => (
        <button class="kind-tag" type="button" data-category={c.name} aria-pressed="false">{c.name}</button>
      ))}
    </fieldset>
    <p class="board-count" id="count" role="status">{copy.listing.total(orgs.length)}</p>

    <ul class="board" id="listings">
      {orgs.map((o, i) => {
        const next = nextFor(o);
        return (
          <li
            class="flyer"
            id={`org-${o.id}`}
            data-categories={o.category.join("|")}
            data-areas={o.area.join("|")}
            data-search={[o.name, o.blurb, ...o.category, ...o.area].join(" ").toLowerCase()}
            data-next={JSON.stringify(next)}
            style={`--paper:${placeColor(o.area)}; --tilt:${tilts[i % tilts.length]}deg; --pin:${pins[i % pins.length]}`}
          >
            <span class="pin" aria-hidden="true"></span>
            <h3>
              {o.website
                ? <a href={o.website} target="_blank" rel="noopener">{o.name}<span class="visually-hidden"> {copy.listing.newTab}</span></a>
                : o.name}
            </h3>
            <p class="meta">
              {o.area.length > 0 && (
                <span class="place">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z"></path>
                    <circle cx="12" cy="9" r="2.5"></circle>
                  </svg>
                  {o.area.join(", ")}
                </span>
              )}
              <span class="kinds">{o.category.join(" + ")}</span>
            </p>
            <p class="blurb">{o.blurb}</p>
            <div class="tabs">
              <a
                class="tab tab-next"
                href={next[0]?.link ?? o.website}
                target="_blank"
                rel="noopener"
                hidden={!next[0]}
                data-next-tab
              >
                <span class="tab-k">{copy.listing.nextLabel}</span>
                <span data-next-when>{next[0]?.when}</span>
                <span class="visually-hidden" data-next-name>: {next[0]?.name}, {o.name} {copy.listing.newTab}</span>
              </a>
              <span class="tab tab-quiet" hidden={!!next[0]} data-next-none>
                <span class="tab-k">{copy.listing.nextLabel}</span>
                <span>{copy.listing.nextNone}</span>
              </span>
              {o.website && (
                <a class="tab" href={o.website} target="_blank" rel="noopener">
                  <span class="tab-k">{copy.listing.visitTab[0]}</span>
                  <span>{copy.listing.visitTab[1]}<span class="visually-hidden">: {o.name} {copy.listing.newTab}</span></span>
                </a>
              )}
              <a class="tab" href={claimHref(o)} target="_blank" rel="noopener">
                <span class="tab-k">{copy.listing.claimTab[0]}</span>
                <span>{copy.listing.claimTab[1]}<span class="visually-hidden">: {o.name} {copy.listing.newTab}</span></span>
              </a>
            </div>
          </li>
        );
      })}
    </ul>
    <div class="board-empty" id="empty" hidden={orgs.length > 0}>
      <p>{copy.listing.empty}</p>
      <button type="button" class="ink-btn" data-reset>{copy.listing.clear}</button>
      <a class="paper-btn" href={TALLY_URL}>{copy.listing.suggest}</a>
    </div>
  </section>

  <section class="wrap pinned-sheets">
    <aside class="sheet" id="organizers" style="--pin:#1F6FD1; --tilt:-0.8deg">
      <span class="pin" aria-hidden="true"></span>
      <h2>{copy.organizers.heading}</h2>
      <p>{copy.organizers.body}</p>
      <a class="ink-btn" href={copy.organizers.href}>{copy.organizers.button}</a>
    </aside>
    <aside class="sheet" id="signup" style="--pin:#E2402F; --tilt:0.9deg">
      <span class="pin" aria-hidden="true"></span>
      <h2>{copy.signup.heading}</h2>
      <p>{copy.signup.body}</p>
      <a class="ink-btn" href={copy.signup.href}>{copy.signup.button}</a>
    </aside>
  </section>

<script>
  import { copy } from "../copy";
  import { wideAreas as wide } from "../areas";
  import { isUpcoming } from "../event-dates";

  type NextEv = { name: string; start: string; end: string | null; allDay: boolean; link: string; when: string };

  // Drop events that have passed since the last rebuild.
  const now = new Date();
  const comingItems = [...document.querySelectorAll<HTMLLIElement>(".coming li")];
  comingItems
    .filter((li) => isUpcoming({ start: li.dataset.start!, end: li.dataset.end || null, allDay: li.dataset.allDay === "true" }, now))
    .forEach((li, i) => (li.hidden = i >= 4));
  comingItems
    .filter((li) => !isUpcoming({ start: li.dataset.start!, end: li.dataset.end || null, allDay: li.dataset.allDay === "true" }, now))
    .forEach((li) => (li.hidden = true));

  const flyers = [...document.querySelectorAll<HTMLElement>(".flyer")];
  flyers.forEach((flyer) => {
    const next = (JSON.parse(flyer.dataset.next || "[]") as NextEv[]).find((e) => isUpcoming(e, now));
    const tab = flyer.querySelector<HTMLAnchorElement>("[data-next-tab]")!;
    const none = flyer.querySelector<HTMLElement>("[data-next-none]")!;
    tab.hidden = !next;
    none.hidden = !!next;
    if (next) {
      tab.href = next.link;
      tab.querySelector("[data-next-when]")!.textContent = next.when;
      const name = flyer.querySelector("h3")!.textContent!.replace(copy.listing.newTab, "").trim();
      tab.querySelector("[data-next-name]")!.textContent = `: ${next.name}, ${name} ${copy.listing.newTab}`;
    }
  });

  // Filters: search words, kind of group, and a town or a whole route group. All combine (AND).
  const search = document.getElementById("search") as HTMLInputElement;
  const kindTags = [...document.querySelectorAll<HTMLButtonElement>(".kind-tag")];
  const townBtns = [...document.querySelectorAll<HTMLButtonElement>("[data-town]")];
  const routeBtns = [...document.querySelectorAll<HTMLButtonElement>("[data-route]")];
  const empty = document.getElementById("empty")!;
  const count = document.getElementById("count")!;
  let kind = "";
  let place: { key: string; towns: string[] } | null = null;

  function update() {
    const words = search.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const f of flyers) {
      const areas = f.dataset.areas!.split("|");
      const inKind = !kind || f.dataset.categories!.split("|").includes(kind);
      const inPlace = !place || areas.some((a) => place!.towns.includes(a) || wide.includes(a));
      const matches = words.every((w) => f.dataset.search!.includes(w));
      f.hidden = !(inKind && inPlace && matches);
      if (!f.hidden) shown++;
    }
    empty.hidden = shown > 0;
    const filtered = words.length > 0 || kind !== "" || place !== null;
    count.textContent = filtered ? copy.listing.showing(shown, flyers.length) : copy.listing.total(flyers.length);
    kindTags.forEach((b) => b.setAttribute("aria-pressed", String((b.dataset.category ?? "") === kind)));
    townBtns.forEach((b) => b.setAttribute("aria-pressed", String(place?.key === `town:${b.dataset.town}`)));
    routeBtns.forEach((b) => b.setAttribute("aria-pressed", String(place?.key === `route:${b.dataset.route}`)));
  }

  const setPlace = (key: string, towns: string[]) => {
    place = place?.key === key ? null : { key, towns };
    update();
  };
  townBtns.forEach((b) => b.addEventListener("click", () => setPlace(`town:${b.dataset.town}`, [b.dataset.town!])));
  routeBtns.forEach((b) => b.addEventListener("click", () => setPlace(`route:${b.dataset.route}`, b.dataset.towns!.split("|"))));
  document.querySelector("[data-route-clear]")!.addEventListener("click", () => {
    place = null;
    update();
  });
  kindTags.forEach((b) =>
    b.addEventListener("click", () => {
      kind = b.dataset.category ?? "";
      update();
    }),
  );
  search.addEventListener("input", update);
  document.querySelector("[data-reset]")!.addEventListener("click", () => {
    kind = "";
    place = null;
    search.value = "";
    update();
  });

  // Phone: each route card's towns open from its arrow button.
  document.querySelectorAll<HTMLButtonElement>(".towns-toggle").forEach((t) =>
    t.addEventListener("click", () => {
      const open = t.getAttribute("aria-expanded") !== "true";
      t.setAttribute("aria-expanded", String(open));
      t.closest(".route-card")!.classList.toggle("is-open", open);
    }),
  );
</script>
</Base>
