---
// Admin: edit a group (/admin/groups/<id>) or add one (/admin/groups/new).
// The form posts back here; Access and the middleware cover both.
import { env } from "cloudflare:workers";
import Admin from "../../../layouts/Admin.astro";
import GroupFields from "../../../components/GroupFields.astro";
import AdminGroupFields from "../../../components/AdminGroupFields.astro";
import ReviewPanel from "../../../components/ReviewPanel.astro";
import { copy } from "../../../copy";
import { emptyGroup, fromRow, readAdmin, readDetails, saveGroup, type Errors, type Group, type GroupDetails, type OrgRow } from "../../../admin/groups";
import { approveWithGroup, changedFields, getSubmission, reviewValues } from "../../../admin/review";

export const prerender = false;

const t = copy.admin;
const id = Astro.params.id ?? "";
const isNew = id === "new";

let existing: OrgRow | null = null;
if (!isNew) {
  existing = await env.DB.prepare("SELECT * FROM orgs WHERE id = ?1").bind(id).first<OrgRow>();
  if (!existing) return new Response(t.notFound, { status: 404, headers: { "content-type": "text/plain; charset=utf-8" } });
}

// Reviewing an organizer's change (?review=<submission id>) or a group they added:
// the form starts from their proposal, and saving approves it.
const rv = copy.admin.review;
const reviewId = Astro.url.searchParams.get("review");
const found = reviewId ? await getSubmission(env.DB, reviewId) : null;
const review =
  found && found.status === "pending" && ((found.kind === "change" && found.orgId === id) || (found.kind === "new" && isNew))
    ? found
    : null;

let values: Group = review ? reviewValues(review, existing) : existing ? fromRow(existing) : emptyGroup();
// Compared with the group as it is now, so edits made since they sent it don't show as theirs.
const was: GroupDetails | undefined = review && existing ? fromRow(existing) : undefined;
const changed = review && was ? changedFields(was, values) : [];
let errors: Errors = {};
let saveError = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const kept = existing ? fromRow(existing) : undefined;
  const details = readDetails(form, kept);
  const admin = readAdmin(form);
  values = { ...details.values, ...admin.values };
  errors = { ...details.errors, ...admin.errors };

  if (Object.keys(errors).length === 0) {
    try {
      if (review) {
        await approveWithGroup(env.DB, review, isNew ? null : id, values);
        return Astro.redirect(`/admin/review/?done=approved&name=${encodeURIComponent(values.name)}`, 303);
      }
      const savedId = await saveGroup(env.DB, isNew ? null : id, values);
      return Astro.redirect(`/admin/?saved=${encodeURIComponent(savedId)}`, 303);
    } catch (e) {
      saveError = e instanceof Error ? e.message : String(e);
    }
  } else {
    Astro.response.status = 400;
  }
}

const heading = review
  ? review.kind === "new" ? rv.newHeading(review.proposed?.name ?? "") : rv.changeHeading(existing?.name ?? "")
  : isNew ? t.newHeading : values.name || existing?.name || t.editHeading;
const errorCount = Object.keys(errors).length;
---

<Admin title={heading} section={review ? "review" : "groups"}>
  <p class="admin-back">{review ? <a href="/admin/review/">{rv.back}</a> : <a href="/admin/">{t.backToGroups}</a>}</p>

  <section class="admin-sheet gf-sheet" aria-labelledby="group-heading">
    <h1 id="group-heading">{review ? heading : isNew ? t.newHeading : existing?.name}</h1>
    {review && (
      <>
        <p class="gf-meta">{review.kind === "new" ? rv.newBody : rv.changedCount(changed.length)}</p>
        <ReviewPanel s={review} />
      </>
    )}
    {existing && (
      <p class="admin-muted gf-meta">
        {t.lastSaved}{" "}
        <time datetime={existing.updated_at}>
          {new Date(existing.updated_at).toLocaleString("en-GB", { dateStyle: "medium", timeStyle: "short", timeZone: "America/New_York" })}
        </time>
        {existing.status === "Live" && <> · <a href={`/#org-${existing.id}`}>{t.seeOnSite}</a></>}
      </p>
    )}

    {(errorCount > 0 || saveError) && (
      <div class="gf-summary" role="alert" tabindex="-1" id="gf-summary">
        <p>{saveError ? `${t.saveFailed} ${saveError}` : t.fixErrors(errorCount)}</p>
      </div>
    )}

    <form method="post" class="gf-form" novalidate>
      <GroupFields values={values} errors={errors} changed={changed} was={was} />
      <AdminGroupFields values={values} errors={errors} />
      <div class="gf-actions">
        <button class="ink-btn" type="submit">{review ? rv.approveSave : isNew ? t.addButton : t.saveButton}</button>
        {review ? (
          <button class="paper-btn" type="submit" form="decline-form">{rv.decline}</button>
        ) : (
          <a href="/admin/">{t.cancel}</a>
        )}
      </div>
    </form>
    {review && (
      <form id="decline-form" method="post" action={`/admin/review/${review.id}`} hidden>
        <input type="hidden" name="action" value="decline" />
      </form>
    )}
  </section>
</Admin>
