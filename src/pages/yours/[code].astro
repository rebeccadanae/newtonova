---
// Organizer page for a personal link: /yours/<code>.
// Steps (?step=): check (default), fix, remove, thanks. The "help me help"
// step comes next block (see docs/superpowers/plans/2026-11-18-organizer-flow.md).
// Nothing here changes a group: every submission waits for Becca in /admin.
import { env } from "cloudflare:workers";
import Organizer from "../../layouts/Organizer.astro";
import Flyer from "../../components/Flyer.astro";
import Steps from "../../components/Steps.astro";
import WhoSend from "../../components/WhoSend.astro";
import OwnerGroupFields from "../../components/OwnerGroupFields.astro";
import { copy } from "../../copy";
import { fromRow, readDetails, type Errors, type GroupDetails, type OrgRow } from "../../admin/groups";
import { findInvite } from "../../organizers/invites";
import { readWho, savePerson, linkPerson, type Who, type WhoErrors } from "../../organizers/people";
import { createSubmission, lastPending, submissionForInvite, type Kind } from "../../organizers/submissions";
import { isUpcoming, whenShort } from "../../event-dates";
import type { FlyerOrg, NextEvent } from "../../flyer";

export const prerender = false;

const t = copy.yours;
const code = Astro.params.code ?? "";
const invite = await findInvite(env.DB, code);

const STEPS = ["check", "fix", "remove", "thanks"] as const;
type Step = (typeof STEPS)[number];
const asked = Astro.url.searchParams.get("step");
const step: Step = (STEPS as readonly string[]).includes(asked ?? "") ? (asked as Step) : "check";

// The group, as stored (only Live groups get a working link).
const row =
  invite && invite.orgStatus === "Live"
    ? await env.DB.prepare("SELECT * FROM orgs WHERE id = ?1").bind(invite.orgId).first<OrgRow>()
    : null;
const gone = !invite || !row;
if (gone) Astro.response.status = 404;

const current: GroupDetails | null = row ? fromRow(row) : null;
const org: FlyerOrg | null = row && current
  ? { id: row.id, name: current.name, website: current.website, category: current.category, area: current.area, blurb: current.blurb }
  : null;

const knownName = invite?.personName ?? "";
const emailKnown = Boolean(invite?.personEmail);

let who: Who = { name: knownName, email: "", role: "" };
let whoErrors: WhoErrors = {};
let details: GroupDetails | null = current;
let detailErrors: Errors = {};
let note = "";

if (!gone && Astro.request.method === "POST" && step !== "thanks") {
  const form = await Astro.request.formData();
  const read = readWho(form, { emailKnown });
  who = read.values;
  whoErrors = read.errors;
  note = String(form.get("note") ?? "").trim().slice(0, 2000);

  let kind: Kind = "confirm";
  let proposed: GroupDetails | null = null;
  if (step === "fix") {
    const d = readDetails(form, { category: current!.category, area: current!.area });
    details = d.values;
    detailErrors = d.errors;
    kind = "change";
    proposed = d.values;
  } else if (step === "remove") {
    kind = "remove";
  }

  if (Object.keys(whoErrors).length === 0 && Object.keys(detailErrors).length === 0) {
    const personId = await savePerson(env.DB, { name: who.name, email: who.email || invite!.personEmail! });
    await linkPerson(env.DB, row!.id, personId, who.role);
    const id = await createSubmission(env.DB, {
      kind,
      orgId: row!.id,
      personId,
      via: "invite",
      inviteCode: code,
      proposed,
      note,
    });
    return Astro.redirect(`/yours/${code}?step=thanks&s=${id}`, 303);
  }
  Astro.response.status = 400;
}

// The flyer's next events (step check only).
let next: NextEvent[] = [];
if (!gone && step === "check") {
  const events = await env.DB.prepare(
    `SELECT name, start, "end", all_day, link FROM events WHERE org_id = ?1 AND status = 'Live' ORDER BY start LIMIT 20`,
  )
    .bind(row!.id)
    .all<{ name: string; start: string; end: string | null; all_day: number; link: string | null }>();
  next = events.results
    .map((e) => ({ name: e.name, start: e.start, end: e.end, allDay: Boolean(e.all_day), link: e.link ?? "" }))
    .filter((e) => isUpcoming(e))
    .slice(0, 3)
    .map((e) => ({ ...e, when: whenShort(e) }));
}

const pending = !gone && step === "check" ? await lastPending(env.DB, row!.id) : null;
const pendingDate = pending
  ? new Date(pending.createdAt).toLocaleDateString("en-GB", { day: "numeric", month: "long", timeZone: "America/New_York" })
  : "";

// Thanks: who sent it and what kind, read back from the submission (it must belong to this link).
let thanks: { name: string; kind: Kind } | null = null;
if (!gone && step === "thanks") {
  const s = await submissionForInvite(env.DB, Astro.url.searchParams.get("s") ?? "", code);
  if (s) {
    const p = await env.DB.prepare("SELECT name FROM people WHERE id = ?1").bind(s.person_id).first<{ name: string }>();
    thanks = { name: p?.name ?? "", kind: s.kind };
  }
}
const thanksBody = thanks?.kind === "change" ? t.thanksChange : thanks?.kind === "remove" ? t.thanksRemove : t.thanksConfirm;
const formErrors = Object.keys(detailErrors).length > 0;
const base = `/yours/${code}`;
---

<Organizer>
  {gone || !org ? (
    <section class="yours-sheet">
      <h1>{t.goneHeading}</h1>
      <p class="yours-muted">{t.gone}</p>
    </section>
  ) : step === "thanks" ? (
    <>
      <Steps current={3} />
      <section class="yours-thanks">
        <span class="pin" aria-hidden="true"></span>
        <h1>{thanks?.name ? t.thanksHeading(thanks.name) : t.thanksNoName}</h1>
        <p>{thanksBody}</p>
        <p class="yours-muted">{t.signoff}</p>
      </section>
      {thanks?.kind !== "remove" && <a class="yours-btn paper" href={`/#org-${org.id}`}>{t.seeFlyer}</a>}
      <p class="yours-small yours-center">{t.later}</p>
    </>
  ) : step === "fix" ? (
    <>
      <Steps current={1} />
      <p class="yours-back"><a href={base}>← {t.back}</a></p>
      <div class="yours-intro">
        <h1>{t.fix.heading}</h1>
        <p>{t.fix.intro}</p>
      </div>
      {formErrors && <p class="yours-alert" role="alert">{t.fixErrors}</p>}
      <form method="post" action={`${base}?step=fix`} class="yours-sheet yours-fields" novalidate>
        <OwnerGroupFields values={details!} errors={detailErrors} />
        <div class="yf">
          <label for="of-note">{t.fix.note} <span class="yf-opt">{t.optional}</span></label>
          <textarea id="of-note" name="note" rows="2">{note}</textarea>
        </div>
        <WhoSend knownName={knownName} who={who} errors={whoErrors} emailKnown={emailKnown}>
          <button class="yours-btn ink" type="submit">{t.fix.send}</button>
        </WhoSend>
      </form>
    </>
  ) : step === "remove" ? (
    <>
      <Steps current={1} />
      <p class="yours-back"><a href={base}>← {t.back}</a></p>
      <div class="yours-intro">
        <h1>{t.remove.heading}</h1>
        <p>{t.remove.intro}</p>
      </div>
      <form method="post" action={`${base}?step=remove`} class="yours-sheet yours-fields" novalidate>
        <div class="yf">
          <label for="rm-note">{t.remove.why} <span class="yf-opt">{t.optional}</span></label>
          <textarea id="rm-note" name="note" rows="3">{note}</textarea>
        </div>
        <WhoSend knownName={knownName} who={who} errors={whoErrors} emailKnown={emailKnown}>
          <button class="yours-btn ink" type="submit">{t.remove.send}</button>
        </WhoSend>
        <p class="yours-quiet-link"><a href={base}>{t.remove.keep}</a></p>
      </form>
    </>
  ) : (
    <>
      <Steps current={1} />
      <div class="yours-intro">
        <h1>{t.hello} <span class="hl">{org.name}</span> {t.onSite}</h1>
        <p>{t.intro}</p>
      </div>

      <Flyer org={org} index={0} next={next} as="div" headingLevel={2} nextLabel={t.nextLabel} />

      <section class="yours-sheet" aria-labelledby="question">
        <h2 id="question">{t.question}</h2>
        {pending && <p class="yours-note">{t.pending(pendingDate)}</p>}
        <form method="post" action={base} novalidate>
          <WhoSend knownName={knownName} who={who} errors={whoErrors} emailKnown={emailKnown}>
            <button class="yours-btn ink" type="submit">{t.looksGood}</button>
          </WhoSend>
        </form>
        <a class="yours-btn paper" href={`${base}?step=fix`}>{t.fixButton}</a>
        <p class="yours-quiet-link"><a href={`${base}?step=remove`}>{t.removeLink}</a></p>
      </section>

      <p class="yours-small">{t.footnote}</p>
    </>
  )}
</Organizer>
