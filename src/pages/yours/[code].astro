---
// Organizer page for a personal link: /yours/<code>.
// Steps (?step=): check (default), fix, remove, then about ("help me help",
// optional) and thanks. The steps are shared with the public path (/yours/):
// logic in src/organizers/flow.ts, screens in YoursSteps.astro.
// Plan: docs/superpowers/plans/2026-11-18-organizer-flow.md.
import { env } from "cloudflare:workers";
import Organizer from "../../layouts/Organizer.astro";
import YoursSteps from "../../components/YoursSteps.astro";
import { copy, ORGANIZER_URL } from "../../copy";
import type { OrgRow } from "../../admin/groups";
import { findInvite } from "../../organizers/invites";
import { readStep, runFlow, type Links } from "../../organizers/flow";

export const prerender = false;

const t = copy.yours;
const code = Astro.params.code ?? "";
const invite = await findInvite(env.DB, code);

// The group, as stored (only Live groups get a working link).
const row =
  invite && invite.orgStatus === "Live"
    ? await env.DB.prepare("SELECT * FROM orgs WHERE id = ?1").bind(invite.orgId).first<OrgRow>()
    : null;
const gone = !invite || !row;
if (gone) Astro.response.status = 404;

const base = `/yours/${code}`;
const links: Links = {
  step: (step) => (step === "check" ? base : `${base}?step=${step}`),
  after: (step, id) => `${base}?step=${step}&s=${id}`,
};

const knownName = invite?.personName ?? "";
const result = gone
  ? null
  : await runFlow({
      db: env.DB,
      request: Astro.request,
      url: Astro.url,
      step: readStep(Astro.url, false),
      row,
      via: "invite",
      inviteCode: code,
      knownName,
      knownEmail: invite?.personEmail ?? null,
      links,
    });
if (result && "redirect" in result) return Astro.redirect(result.redirect, 303);
const state = result;
if (state && (Object.keys(state.whoErrors).length > 0 || Object.keys(state.detailErrors).length > 0)) {
  Astro.response.status = 400;
}
---

<Organizer>
  {!state ? (
    <section class="yours-sheet">
      <h1>{t.goneHeading}</h1>
      <p class="yours-muted">{t.gone}</p>
      <a class="yours-btn ink" href={ORGANIZER_URL}>{t.findGroup}</a>
      <p class="yours-small">{t.goneAsk} <a href="mailto:hello@newtonova.org">hello@newtonova.org</a>.</p>
    </section>
  ) : (
    <YoursSteps state={state} links={links} knownName={knownName} emailKnown={Boolean(invite?.personEmail)} />
  )}
</Organizer>
