---
// Layout for /admin: a working tool, so no pins, tilts or analytics.
import "../styles/global.css";
import "../styles/admin.css";
import { env } from "cloudflare:workers";
import { copy } from "../copy";
import { pendingCount } from "../admin/review";
import { publishState } from "../admin/publish";

interface Props {
  title: string;
  section?: "groups" | "events" | "review" | "answers";
}

const { title, section = "groups" } = Astro.props;
const email = Astro.locals.adminEmail;
const [waiting, pub] = await Promise.all([
  pendingCount(env.DB),
  publishState(env.DB, (env as unknown as { DEPLOY_HOOK_URL?: string }).DEPLOY_HOOK_URL),
]);
const p = copy.admin.publish;
const publishFailed = Astro.url.searchParams.get("publish") === "failed";
// After publishing, come back here (without the failure note).
const backParams = new URLSearchParams(Astro.url.search);
backParams.delete("publish");
const back = Astro.url.pathname + (backParams.size ? `?${backParams}` : "");
const nyTime = (iso: string) =>
  new Date(iso).toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit", timeZone: "America/New_York" }).toLowerCase().replace(" ", "");
const nyWhen = (iso: string) =>
  `${new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "America/New_York" })}, ${nyTime(iso)}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · newtonova admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Overpass:wght@400;600;700;800&display=swap" />
  </head>
  <body class="admin">
    <header class="site-header">
      <div class="wrap admin-bar">
        <a class="logo" href="/admin/">new to nova <span class="admin-badge">{copy.admin.title}</span></a>
        <nav class="admin-nav" aria-label={copy.admin.title}>
          <a href="/admin/" aria-current={section === "groups" ? "page" : undefined}>{copy.admin.groupsHeading}</a>
          <a href="/admin/events/" aria-current={section === "events" ? "page" : undefined}>{copy.admin.events.heading}</a>
          <a href="/admin/review/" aria-current={section === "review" ? "page" : undefined}>
            {copy.admin.review.nav}{waiting > 0 && <span class="admin-count">{waiting}</span>}
          </a>
          <a href="/admin/answers/" aria-current={section === "answers" ? "page" : undefined}>{copy.admin.answersPage.nav}</a>
        </nav>
        <p class="admin-who">
          {email && <span>{copy.admin.signedInAs} {email}</span>}
          <a href="/">{copy.admin.viewSite}</a>
        </p>
      </div>
    </header>
    <main class="wrap admin-main">
      <form class="admin-publish" method="post" action="/admin/publish" data-state={pub.kind}>
        <p role="status">
          {publishFailed && <strong class="admin-publish-failed">{p.failed} </strong>}
          {pub.kind === "off" && p.off}
          {pub.kind === "publishing" && p.publishing(nyTime(pub.since))}
          {pub.kind === "waiting" && (pub.lastBuilt ? (
            <>{pub.edits > 0 ? p.waiting(pub.edits) : p.unknown} <span>{p.lastBuilt(nyWhen(pub.lastBuilt))}</span></>
          ) : p.unknown)}
          {pub.kind === "upToDate" && <>{p.upToDate} <span>{p.lastBuilt(nyWhen(pub.lastBuilt))}</span></>}
        </p>
        {pub.kind !== "off" && pub.kind !== "publishing" && (
          <>
            <input type="hidden" name="back" value={back} />
            <button class={pub.kind === "waiting" ? "ink-btn" : "paper-btn"} type="submit">{p.button}</button>
          </>
        )}
      </form>
      <slot />
    </main>
  </body>
</html>
