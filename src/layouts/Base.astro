---
import "../styles/global.css";
import { copy } from "../copy";

interface Props {
  title?: string;
  description?: string;
  current?: "groups" | "events" | "about" | "join";
}

const here = (page: Props["current"]) => (current === page ? "page" : undefined);

const { title = copy.siteTitle, description = copy.metaDescription, current } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Overpass:ital,wght@0,400;0,600;0,700;0,800;1,800&display=swap"
    />
    <!-- Umami visitor stats (cookieless). Only counts visits on newtonova.org. -->
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="4711af59-982a-4cc4-abd0-6bb4497ef8b2"
      data-domains="newtonova.org"
    ></script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/">
          <!-- Same drawing as public/favicon.svg, without its ink square (the header is ink). -->
          <svg class="logo-mark" viewBox="0 12 64 44" aria-hidden="true"><path fill="#CFE2EA" d="M12.9 42.2L15.7 44.9L25.3 39.8L28.0 28.6L30.9 29.7L32.4 25.1L33.5 25.7L36.1 21.1L36.0 18.2L40.5 20.6L42.1 18.5L46.9 21.8L45.8 26.8L47.8 26.2L48.8 27.9L54.9 29.8L54.5 32.6L49.7 30.1L55.0 33.0L55.7 35.3L54.5 34.7L54.2 36.3L56.1 38.3L50.9 37.2L52.9 37.0L55.0 39.6L58.6 38.6L60.3 41.9L2.0 53.8L5.7 51.6L12.9 42.2ZM59.0 28.3L62.0 26.9L58.4 37.0L59.0 28.3Z"/><circle cx="47.2" cy="19.6" r="4.8" fill="#0E1619" fill-opacity=".5"/><circle cx="46.4" cy="18.6" r="4.8" fill="#E2402F"/><circle cx="44.8" cy="17.0" r="1.5" fill="#fff" fill-opacity=".7"/></svg>
          new to nova
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">{copy.nav.menu}</button>
        <nav class="site-nav" id="site-nav" aria-label={copy.nav.label}>
          <a href="/" aria-current={here("groups")}>{copy.nav.groups}</a>
          <a href="/events/" aria-current={here("events")}>{copy.nav.events}</a>
          <a href="/about/" aria-current={here("about")}>{copy.nav.about}</a>
          <a class="btn btn-solid nav-cta" href="/join/" aria-current={here("join")}>{copy.nav.email}</a>
        </nav>
      </div>
    </header>

    <script>
      // Phone-width Menu button: shows and hides the stacked links.
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle")!;
      const header = document.querySelector(".site-header")!;
      toggle.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") !== "true";
        toggle.setAttribute("aria-expanded", String(open));
        header.classList.toggle("menu-open", open);
      });
    </script>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>{copy.footer.site}</span>
        <a href={copy.footer.suggestHref}>{copy.footer.suggest}</a>
      </div>
    </footer>
  </body>
</html>
