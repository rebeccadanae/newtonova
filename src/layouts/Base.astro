---
import "../styles/global.css";
import { copy } from "../copy";

interface Props {
  title?: string;
  description?: string;
  current?: "about" | "join";
}

const { title = copy.siteTitle, description = copy.metaDescription, current } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/">new to <em>nova</em></a>
        <nav class="site-nav" aria-label="Main">
          <a href="/join/" aria-current={current === "join" ? "page" : undefined}>{copy.nav.email}</a>
          <a href="/about/" aria-current={current === "about" ? "page" : undefined}>{copy.nav.about}</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>{copy.footer.site}</span>
        <a href={copy.footer.suggestHref}>{copy.footer.suggest}</a>
      </div>
    </footer>
  </body>
</html>
